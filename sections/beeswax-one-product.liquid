</style>

<script>
(function() {
  const root = document.getElementById('beeswax-store-{{ section.id }}');
  if (!root || root.dataset.initialized) return;
  root.dataset.initialized = 'true';

  const form = root.querySelector('.bw-product-form');
  const variantSelect = root.querySelector('.bw-variant-select');
  const price = root.querySelector('#bw-price-{{ section.id }}');
  const buyButton = root.querySelector('.bw-buy-button');

  if (variantSelect) {
    variantSelect.addEventListener('change', function() {
      const option = this.options[this.selectedIndex];
      const selectedVariant = this.value;
      const isAvailable = !option.disabled;

      if (price && option.dataset.price) {
        price.textContent = option.dataset.price;
      }

      if (buyButton) {
        buyButton.disabled = !isAvailable;
        buyButton.textContent = isAvailable
          ? 'ADD TO CART — ' + option.dataset.price
          : 'SOLD OUT';
      }
    });
  }

  if (form) {
    form.addEventListener('submit', function() {
      if (buyButton && !buyButton.disabled) {
        buyButton.textContent = 'ADDING TO CART...';
      }
    });
  }
})();
</script>

