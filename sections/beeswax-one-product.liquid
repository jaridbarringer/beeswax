
{% comment %}
  BEESWAX BREAD BAG — EDITORIAL ONE-PRODUCT STOREFRONT
  Theme: Shopify Dawn
  File: sections/beeswax-one-product.liquid
{% endcomment %}

{% liquid
  assign product_item = section.settings.product
  if product_item == blank
    assign product_item = all_products['beeswax-bread-bag']
  endif

  assign current_variant = product_item.selected_or_first_available_variant
  assign hero_image = section.settings.hero_image | default: product_item.featured_image
%}

<section id="beeswax-store-{{ section.id }}" class="bw-store">

  {% if product_item == blank %}
    <div class="bw-missing">
      <h2>Select your beeswax bread bag product</h2>
      <p>Open this section in the Shopify theme editor and choose your product.</p>
    </div>
  {% else %}

  <!-- NAVIGATION -->
  <nav class="bw-nav">
    <a href="#bw-home-{{ section.id }}" class="bw-brand">
      {{ section.settings.brand_name | escape }}
    </a>

    <div class="bw-nav-links">
      <a href="#bw-story-{{ section.id }}">Our Story</a>
      <a href="#bw-benefits-{{ section.id }}">Why Beeswax</a>
      <a href="#bw-product-{{ section.id }}">Shop</a>
    </div>

    <a href="#bw-product-{{ section.id }}" class="bw-nav-cta">
      SHOP NOW <span>↗</span>
    </a>
  </nav>

  <!-- HERO -->
  <header id="bw-home-{{ section.id }}" class="bw-hero">

    {% if hero_image != blank %}
      <div class="bw-hero-image">
        {{
          hero_image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 2000, 2400',
            sizes: '100vw',
            class: 'bw-hero-photo',
            fetchpriority: 'high'
        }}
      </div>
    {% endif %}

    <div class="bw-hero-shade"></div>

    <div class="bw-hero-content">
      <span class="bw-eyebrow">
        {{ section.settings.hero_eyebrow | escape }}
      </span>

      <h1>{{ section.settings.hero_heading }}</h1>

      <p>{{ section.settings.hero_description }}</p>

      <a href="#bw-product-{{ section.id }}" class="bw-button bw-button-light">
        DISCOVER THE BREAD BAG <span>↗</span>
      </a>
    </div>

    <div class="bw-hero-bottom">
      <span>MADE FOR THE LOVE OF GOOD BREAD</span>
      <span>01 — 04</span>
    </div>
  </header>

  <!-- INTRODUCTION -->
  <section class="bw-intro">

    <div class="bw-intro-gradient"></div>

    <div class="bw-intro-content">
      <span class="bw-eyebrow bw-dark-eyebrow">
        A MORE NATURAL WAY
      </span>

      <h2>
        Good bread deserves<br>
        <em>a better home.</em>
      </h2>

      <p>
        {{ section.settings.intro_text }}
      </p>
    </div>

    <div class="bw-intro-mark">NATURALLY BETTER.</div>
  </section>

  <!-- PRODUCT STORY -->
  <section id="bw-story-{{ section.id }}" class="bw-story">

    <div class="bw-story-image">
      {% if product_item.featured_image %}
        {{
          product_item.featured_image
          | image_url: width: 1500
          | image_tag:
            widths: '500, 750, 1000, 1500',
            loading: 'lazy',
            sizes: '(min-width: 750px) 55vw, 100vw'
        }}
      {% endif %}
    </div>

    <div class="bw-story-copy">
      <span class="bw-eyebrow bw-dark-eyebrow">THE EVERYDAY RITUAL</span>

      <h2>
        A little less<br>
        <em>plastic.</em><br>
        A lot more purpose.
      </h2>

      <p>
        {{ section.settings.story_text }}
      </p>

      <a href="#bw-product-{{ section.id }}" class="bw-text-link">
        GET TO KNOW YOUR NEW BREAD BAG ↗
      </a>
    </div>
  </section>

  <!-- BENEFITS -->
  <section id="bw-benefits-{{ section.id }}" class="bw-benefits">

    <div class="bw-benefits-heading">
      <span class="bw-eyebrow">THOUGHTFULLY MADE</span>
      <h2>Simple things.<br><em>Better living.</em></h2>
    </div>

    <div class="bw-benefit-grid">

      <article class="bw-benefit">
        <span class="bw-benefit-number">01</span>
        <div class="bw-benefit-icon">✳</div>
        <h3>Beeswax coated</h3>
        <p>A reusable beeswax-coated fabric alternative to disposable bread storage bags.</p>
      </article>

      <article class="bw-benefit">
        <span class="bw-benefit-number">02</span>
        <div class="bw-benefit-icon">⌂</div>
        <h3>Made for everyday</h3>
        <p>A practical addition to your kitchen, designed to be used again and again.</p>
      </article>

      <article class="bw-benefit">
        <span class="bw-benefit-number">03</span>
        <div class="bw-benefit-icon">♡</div>
        <h3>Reusable by design</h3>
        <p>Reduce your reliance on disposable storage and enjoy a more intentional routine.</p>
      </article>

    </div>
  </section>

  <!-- PRODUCT EXPERIENCE -->
  <section class="bw-experience">

    <div class="bw-experience-overlay"></div>

    <div class="bw-experience-content">
      <span class="bw-eyebrow">FROM OUR KITCHEN TO YOURS</span>
      <h2>Keep the good<br><em>things fresh.</em></h2>
      <p>Bring a little more intention to the way you store your favorite loaf.</p>
      <a href="#bw-product-{{ section.id }}" class="bw-button bw-button-light">
        EXPLORE THE BAG ↗
      </a>
    </div>

    {% if hero_image != blank %}
      <div class="bw-experience-photo">
        {{
          hero_image
          | image_url: width: 1800
          | image_tag:
            widths: '750, 1100, 1500, 1800',
            loading: 'lazy',
            sizes: '100vw'
        }}
      </div>
    {% endif %}

  </section>

  <!-- BRAND STORY -->
  <section class="bw-brand-story">

    <div class="bw-brand-story-inner">
      <span class="bw-eyebrow bw-dark-eyebrow">THE ART OF EVERYDAY LIVING</span>

      <h2>
        Not everything<br>
        needs to be <em>complicated.</em>
      </h2>

      <p>
        We believe the best things in life are often the simplest.
        A good loaf of bread. A warm kitchen. Thoughtful products
        that make everyday moments a little more meaningful.
      </p>

      <span class="bw-signature">{{ section.settings.brand_name }}</span>
    </div>

  </section>

  <!-- PURCHASE -->
  <section id="bw-product-{{ section.id }}" class="bw-purchase">

    <div class="bw-purchase-image">
      {% if product_item.featured_image %}
        {{
          product_item.featured_image
          | image_url: width: 1600
          | image_tag:
            widths: '500, 750, 1100, 1600',
            loading: 'lazy',
            sizes: '(min-width: 750px) 50vw, 100vw'
        }}
      {% endif %}

      <div class="bw-image-caption">
        {{ product_item.title | escape }}
      </div>
    </div>

    <div class="bw-purchase-details">

      <span class="bw-eyebrow bw-dark-eyebrow">THE EVERYDAY ESSENTIAL</span>

      <h2>{{ product_item.title | escape }}</h2>

      <div class="bw-price">
        <span id="bw-price-{{ section.id }}">
          {{ current_variant.price | money }}
        </span>

        {% if current_variant.compare_at_price > current_variant.price %}
          <s>{{ current_variant.compare_at_price | money }}</s>
        {% endif %}
      </div>

      <p class="bw-purchase-description">
        {{ product_item.description | strip_html | truncate: 250 }}
      </p>

      <div class="bw-specification">
        <span>DIMENSIONS</span>
        <strong>16 × 14 INCHES</strong>
      </div>

      {% assign bw_form_id = 'bw-form-' | append: section.id %}
{% form 'product', product_item, id: bw_form_id, class: 'bw-product-form' %}

        {% if product_item.has_only_default_variant == false %}
          <label for="bw-variant-{{ section.id }}">Choose an option</label>

          <select
            id="bw-variant-{{ section.id }}"
            name="id"
            class="bw-variant-select"
          >
            {% for variant in product_item.variants %}
              <option
                value="{{ variant.id }}"
                {% if variant.id == current_variant.id %}selected{% endif %}
                {% unless variant.available %}disabled{% endunless %}
                data-price="{{ variant.price | money | escape }}"
              >
                {{ variant.title | escape }}
                {% unless variant.available %} — Sold out{% endunless %}
              </option>
            {% endfor %}
          </select>
        {% else %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {% endif %}

        <label for="bw-quantity-{{ section.id }}">QUANTITY</label>
        <input
          id="bw-quantity-{{ section.id }}"
          type="number"
          name="quantity"
          value="1"
          min="1"
          class="bw-quantity"
        >

        <button
          type="submit"
          name="add"
          class="bw-buy-button"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {% if current_variant.available %}
            ADD TO CART — {{ current_variant.price | money }}
          {% else %}
            SOLD OUT
          {% endif %}
        </button>

        {{ form | payment_button }}

        {% if form.errors %}
          <div class="bw-errors">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

      {% endform %}

      <div class="bw-trust">
        <span>↻ REUSABLE DESIGN</span>
        <span>♡ THOUGHTFULLY MADE</span>
      </div>

    </div>
  </section>

  <!-- FAQ -->
  <section class="bw-faq">

    <div class="bw-faq-heading">
      <span class="bw-eyebrow bw-dark-eyebrow">GOOD TO KNOW</span>
      <h2>A few things<br><em>you might wonder.</em></h2>
    </div>

    <div class="bw-faq-list">

      <details>
        <summary>What are the dimensions?</summary>
        <p>The bread bag measures 16 × 14 inches.</p>
      </details>

      <details>
        <summary>What is the bag made from?</summary>
        <p>It features beeswax-coated fabric. Refer to the product packaging for the full material composition.</p>
      </details>

      <details>
        <summary>How do I care for my bread bag?</summary>
        <p>Follow the care instructions supplied with your product. Avoid hot water and high heat unless the manufacturer's instructions specify otherwise.</p>
      </details>

      <details>
        <summary>Can I reuse it?</summary>
        <p>Yes. It is designed as a reusable alternative to disposable bread storage bags.</p>
      </details>

    </div>
  </section>

  <!-- FINAL CTA -->
  <footer class="bw-footer">

    <span class="bw-eyebrow">A LITTLE MORE INTENTION. EVERY DAY.</span>

    <h2>Make room for<br><em>the good things.</em></h2>

    <a href="#bw-product-{{ section.id }}" class="bw-button bw-button-light">
      SHOP THE BREAD BAG ↗
    </a>

    <div class="bw-footer-bottom">
      <span>{{ section.settings.brand_name | escape }}</span>
      <span>MADE FOR EVERYDAY LIVING</span>
      <a href="#bw-home-{{ section.id }}">BACK TO TOP ↑</a>
    </div>

  </footer>

  {% endif %}
</section>

<style>
#beeswax-store-{{ section.id }} {
  --espresso: #38251C;
  --dark: #493226;
  --walnut: #654533;
  --caramel: #A47757;
  --sand: #D5BFA4;
  --oat: #F0E5D5;
  --cream: #FAF6EF;
  --ink: #38251C;

  color: var(--ink);
  background: var(--cream);
  font-family: Arial, sans-serif;
  overflow: clip;
  scroll-behavior: smooth;
}

#beeswax-store-{{ section.id }} *,
#beeswax-store-{{ section.id }} *::before,
#beeswax-store-{{ section.id }} *::after {
  box-sizing: border-box;
}

#beeswax-store-{{ section.id }} h1,
#beeswax-store-{{ section.id }} h2,
#beeswax-store-{{ section.id }} h3 {
  font-family: Georgia, 'Times New Roman', serif;
  font-weight: 400;
  letter-spacing: -.055em;
}

#beeswax-store-{{ section.id }} h1 em,
#beeswax-store-{{ section.id }} h2 em {
  font-weight: 400;
  font-style: italic;
}

#beeswax-store-{{ section.id }} img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

#beeswax-store-{{ section.id }} a {
  text-decoration: none;
  color: inherit;
}

#beeswax-store-{{ section.id }} .bw-eyebrow {
  display: block;
  font-size: 10px;
  letter-spacing: .23em;
  font-weight: 600;
  line-height: 1.6;
}

#beeswax-store-{{ section.id }} .bw-dark-eyebrow {
  color: #8B6448;
}

/* NAVIGATION */

#beeswax-store-{{ section.id }} .bw-nav {
  height: 75px;
  background: var(--cream);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6%;
  position: relative;
  z-index: 10;
}

#beeswax-store-{{ section.id }} .bw-brand {
  font-family: Georgia, serif;
  font-size: 23px;
  letter-spacing: -.04em;
}

#beeswax-store-{{ section.id }} .bw-nav-links {
  display: flex;
  gap: 35px;
  font-size: 11px;
  letter-spacing: .12em;
  text-transform: uppercase;
}

#beeswax-store-{{ section.id }} .bw-nav-cta {
  border: 1px solid var(--espresso);
  padding: 13px 19px;
  font-size: 10px;
  letter-spacing: .13em;
}

/* HERO */

#beeswax-store-{{ section.id }} .bw-hero {
  min-height: 760px;
  height: min(90vh, 950px);
  background: var(--espresso);
  position: relative;
  isolation: isolate;
  display: flex;
  align-items: center;
  overflow: hidden;
  color: white;
}

#beeswax-store-{{ section.id }} .bw-hero-image,
#beeswax-store-{{ section.id }} .bw-hero-shade {
  position: absolute;
  inset: 0;
}

#beeswax-store-{{ section.id }} .bw-hero-photo {
  opacity: .88;
}

#beeswax-store-{{ section.id }} .bw-hero-shade {
  z-index: 1;
  background:
    linear-gradient(90deg,
      rgba(39,24,17,.78) 0%,
      rgba(39,24,17,.44) 48%,
      rgba(39,24,17,.08) 100%),
    linear-gradient(0deg,
      rgba(56,37,28,.92) 0%,
      transparent 35%);
}

#beeswax-store-{{ section.id }} .bw-hero-content {
  max-width: 850px;
  padding: 90px 10%;
  position: relative;
  z-index: 2;
}

#beeswax-store-{{ section.id }} .bw-hero h1 {
  font-size: clamp(60px, 8.5vw, 112px);
  line-height: .98;
  margin: 30px 0;
  color: white;
}

#beeswax-store-{{ section.id }} .bw-hero-content p {
  font-size: 15px;
  line-height: 1.9;
  max-width: 430px;
  color: #F0E5D5;
  margin-bottom: 35px;
}

#beeswax-store-{{ section.id }} .bw-hero-bottom {
  position: absolute;
  z-index: 2;
  bottom: 32px;
  left: 6%;
  right: 6%;
  display: flex;
  justify-content: space-between;
  font-size: 9px;
  letter-spacing: .2em;
}

#beeswax-store-{{ section.id }} .bw-button {
  display: inline-flex;
  gap: 35px;
  align-items: center;
  justify-content: space-between;
  padding: 19px 25px;
  font-size: 10px;
  letter-spacing: .15em;
  transition: .3s ease;
}

#beeswax-store-{{ section.id }} .bw-button-light {
  color: var(--espresso);
  background: var(--cream);
}

#beeswax-store-{{ section.id }} .bw-button-light:hover {
  background: var(--sand);
  transform: translateY(-3px);
}

/* INTRO */

#beeswax-store-{{ section.id }} .bw-intro {
  min-height: 590px;
  padding: 130px 20px 150px;
  position: relative;
  isolation: isolate;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: linear-gradient(
    180deg,
    var(--espresso) 0%,
    #76533D 10%,
    #B79576 30%,
    #E2D1BC 65%,
    var(--cream) 100%
  );
}

#beeswax-store-{{ section.id }} .bw-intro-gradient {
  position: absolute;
  inset: 0;
  background: radial-gradient(
    ellipse at 50% 65%,
    rgba(250,246,239,.45),
    transparent 65%
  );
  z-index: -1;
}

#beeswax-store-{{ section.id }} .bw-intro-content {
  max-width: 750px;
}

#beeswax-store-{{ section.id }} .bw-intro h2 {
  font-size: clamp(48px, 7vw, 86px);
  line-height: 1.03;
  margin: 28px 0;
}

#beeswax-store-{{ section.id }} .bw-intro-content p {
  max-width: 520px;
  margin: 0 auto;
  font-size: 14px;
  line-height: 2;
  color: #634B3A;
}

#beeswax-store-{{ section.id }} .bw-intro-mark {
  position: absolute;
  bottom: 35px;
  font-size: 9px;
  letter-spacing: .3em;
}

/* STORY */

#beeswax-store-{{ section.id }} .bw-story {
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  min-height: 700px;
  background: var(--cream);
}

#beeswax-store-{{ section.id }} .bw-story-image {
  min-height: 650px;
  overflow: hidden;
}

#beeswax-store-{{ section.id }} .bw-story-image img {
  transition: transform 1s ease;
}

#beeswax-store-{{ section.id }} .bw-story:hover .bw-story-image img {
  transform: scale(1.035);
}

#beeswax-store-{{ section.id }} .bw-story-copy {
  padding: 90px 12%;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

#beeswax-store-{{ section.id }} .bw-story h2 {
  font-size: clamp(50px, 5.7vw, 76px);
  line-height: 1.03;
  margin: 28px 0;
}

#beeswax-store-{{ section.id }} .bw-story-copy p {
  line-height: 2;
  font-size: 14px;
  color: #755E4C;
  max-width: 430px;
  margin-bottom: 30px;
}

#beeswax-store-{{ section.id }} .bw-text-link {
  font-size: 10px;
  letter-spacing: .14em;
  font-weight: bold;
}

/* BENEFITS */

#beeswax-store-{{ section.id }} .bw-benefits {
  padding: 120px 8%;
  background: linear-gradient(
    180deg,
    var(--cream) 0%,
    #E9DCCB 45%,
    #D6BEA3 100%
  );
}

#beeswax-store-{{ section.id }} .bw-benefits-heading {
  text-align: center;
  margin-bottom: 75px;
}

#beeswax-store-{{ section.id }} .bw-benefits h2 {
  font-size: clamp(50px, 6vw, 78px);
  line-height: 1;
  margin-top: 25px;
}

#beeswax-store-{{ section.id }} .bw-benefit-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 45px;
}

#beeswax-store-{{ section.id }} .bw-benefit {
  border-top: 1px solid rgba(56,37,28,.3);
  padding-top: 25px;
  position: relative;
}

#beeswax-store-{{ section.id }} .bw-benefit-number {
  font-size: 10px;
  letter-spacing: .2em;
}

#beeswax-store-{{ section.id }} .bw-benefit-icon {
  font-size: 35px;
  margin: 35px 0 20px;
  color: #805B42;
}

#beeswax-store-{{ section.id }} .bw-benefit h3 {
  font-size: 30px;
  margin: 0 0 15px;
}

#beeswax-store-{{ section.id }} .bw-benefit p {
  color: #715B49;
  font-size: 13px;
  line-height: 1.9;
  max-width: 320px;
}

/* EXPERIENCE */

#beeswax-store-{{ section.id }} .bw-experience {
  min-height: 680px;
  position: relative;
  isolation: isolate;
  display: flex;
  align-items: center;
  background: var(--espresso);
  overflow: hidden;
}

#beeswax-store-{{ section.id }} .bw-experience-photo {
  position: absolute;
  inset: 0;
  z-index: -2;
}

#beeswax-store-{{ section.id }} .bw-experience-photo img {
  opacity: .8;
}

#beeswax-store-{{ section.id }} .bw-experience-overlay {
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(
    90deg,
    rgba(43,27,19,.9) 0%,
    rgba(43,27,19,.55) 55%,
    rgba(43,27,19,.05) 100%
  );
}

#beeswax-store-{{ section.id }} .bw-experience-content {
  padding: 100px 10%;
  color: white;
  max-width: 750px;
}

#beeswax-store-{{ section.id }} .bw-experience h2 {
  font-size: clamp(58px, 8vw, 100px);
  line-height: .98;
  margin: 30px 0;
}

#beeswax-store-{{ section.id }} .bw-experience-content p {
  line-height: 1.9;
  font-size: 14px;
  max-width: 390px;
  color: #EADCCD;
  margin-bottom: 35px;
}

/* BRAND STORY */

#beeswax-store-{{ section.id }} .bw-brand-story {
  padding: 145px 20px;
  background: linear-gradient(
    180deg,
    #76533D 0%,
    #D0B69A 17%,
    #F0E5D5 55%,
    var(--cream) 100%
  );
  text-align: center;
}

#beeswax-store-{{ section.id }} .bw-brand-story-inner {
  max-width: 760px;
  margin: auto;
}

#beeswax-store-{{ section.id }} .bw-brand-story h2 {
  font-size: clamp(48px, 7vw, 84px);
  line-height: 1.04;
  margin: 30px 0;
}

#beeswax-store-{{ section.id }} .bw-brand-story p {
  max-width: 550px;
  margin: auto;
  line-height: 2;
  font-size: 14px;
  color: #755D4A;
}

#beeswax-store-{{ section.id }} .bw-signature {
  display: block;
  margin-top: 45px;
  font-family: Georgia, serif;
  font-style: italic;
  font-size: 24px;
}

/* PURCHASE */

#beeswax-store-{{ section.id }} .bw-purchase {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: #F2E8DA;
  align-items: stretch;
}

#beeswax-store-{{ section.id }} .bw-purchase-image {
  min-height: 700px;
  position: relative;
}

#beeswax-store-{{ section.id }} .bw-purchase-image img {
  position: absolute;
  inset: 0;
}

#beeswax-store-{{ section.id }} .bw-image-caption {
  position: absolute;
  bottom: 30px;
  left: 35px;
  color: white;
  font-family: Georgia, serif;
  font-size: 22px;
  text-shadow: 0 1px 12px rgba(0,0,0,.5);
}

#beeswax-store-{{ section.id }} .bw-purchase-details {
  padding: 100px 12%;
